{
  "name": "nexus-corp-messenger",
  "version": "1.0.0",
  "description": "Визуальная оболочка для корпоративного мессенджера Nexus",
  "main": "main.cjs",
  "scripts": {
    "dev" : "electronmon .",
    "start": "electron .",
    "build": "electron-packager . SoborMessenger --platform=win32 --arch=x64 --out=release --overwrite --icon=icon/icon.ico",
    "build:linux": "electron-packager . SoborMessenger --platform=linux --arch=x64 --out=release --overwrite --icon=icon/icon.png",
    "build:linux:arm64": "electron-packager . SoborMessenger --platform=linux --arch=arm64 --out=release --overwrite --icon=icon/icon.png",
    "build:all": "npm run build && npm run build:linux"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-packager": "^17.1.2",
    "electronmon": "^2.0.4"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "google-protobuf": "^4.0.2"
  }
}
